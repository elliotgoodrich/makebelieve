# A manifest whose builds fail on purpose, one way each, to show what the
# `errors` output reports. Like the basic example, every command uses
# `cmake -E` or `cmake -P`, so it works under sh or cmd.exe alike.

# What is failing right now - empty once everything builds.
@/errors.txt = errors

# This one builds.
@/good.txt = capture cmake -E echo "this one builds"

# A command that exits nonzero, explaining itself on standard error the way a
# compiler does.
@/compiled.txt = capture cmake -DINPUT=source.txt -P compile.cmake

# A tool that is not installed.
@/missing-tool.txt = capture makebelieve-example-no-such-tool --version

# A `run` command that succeeds but never writes its output to %out.
@/forgot-out.txt = run cmake -E echo "built it, honest"

# A copy of a file that does not exist.
@/missing-source.txt = copy does-not-exist.txt

# An output that reads one that fails, so fails too.
@/downstream.txt = run cmake -E copy @/compiled.txt %out
