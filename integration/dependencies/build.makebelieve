# Outputs whose commands open other outputs through the mount, naming each
# with `@/`. Every graph here is acyclic.

# A chain far longer than the daemon's cap of one build, ending in a source
# file: each command opens the next output as it runs.
@/chain1.txt = capture cmake -E cat @/chain2.txt
@/chain2.txt = capture cmake -E cat @/chain3.txt
@/chain3.txt = capture cmake -E cat @/chain4.txt
@/chain4.txt = capture cmake -E cat @/chain5.txt
@/chain5.txt = capture cmake -E cat @/chain6.txt
@/chain6.txt = capture cmake -E cat leaf.txt

# Fan-in: many outputs over one generated leaf, opened at once.
@/fan1.txt = capture cmake -E cat @/shared.txt
@/fan2.txt = capture cmake -E cat @/shared.txt
@/fan3.txt = capture cmake -E cat @/shared.txt
@/fan4.txt = capture cmake -E cat @/shared.txt
@/shared.txt = capture cmake -E cat shared-leaf.txt

# A command whose very first action is to open a generated output: attributed
# only if it was registered before it ran.
@/first.txt = run cmake -E copy @/firstdep.txt %out
@/firstdep.txt = capture cmake -E cat leaf.txt

# A copy of the head of the chain, which the daemon serves itself, waiting on
# the chain without holding the only permit.
@/copied.txt = copy @/chain1.txt
