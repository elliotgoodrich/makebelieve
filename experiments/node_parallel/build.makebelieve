# Ten slow outputs per way of loading them: each waits a second, then copies
# module.mjs (or module.js for require), so loading all ten takes about 1s if
# their builds overlap and about 10s if they run one at a time.

@/static0.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static1.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static2.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static3.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static4.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static5.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static6.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static7.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static8.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out
@/static9.mjs = run cmake -E sleep 1 && cmake -E copy module.mjs %out

