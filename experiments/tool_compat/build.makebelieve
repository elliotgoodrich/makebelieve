# One slow output per tool invocation: each waits a second, then copies
# input.txt, so a tool that does not wait for the build sees the wrong bytes.
@/00.txt <- cmake -E sleep 1 && cmake -E copy input.txt %out
@/01.txt <- cmake -E sleep 1 && cmake -E copy input.txt %out
@/02.txt <- cmake -E sleep 1 && cmake -E copy input.txt %out
